# Copie para .env (que fica fora do git) e ajuste se quiser.
POSTGRES_USER=agrovigilance
POSTGRES_PASSWORD=agrovigilance
POSTGRES_DB=agrovigilance
POSTGRES_PORT=5432

# Floci (emulador de AWS): qualquer credencial não vazia serve.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=sa-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Talhão fixo do poller Open-Meteo (ADR-0018). Coordenada genérica de exemplo:
# a real fica só no seu .env.
# Opcional; o padrão é a API pública e gratuita.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

FIELD_TENANT_ID=caliman
FIELD_ID=sede
FIELD_LAT=-15.7801
FIELD_LON=-47.9292
# Fuso do talhão: a sugestão de horário só sai entre 6h e 18h locais (ADR-0024)
FIELD_TIMEZONE=America/Sao_Paulo
